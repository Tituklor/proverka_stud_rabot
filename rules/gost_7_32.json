{
  "profile": "gost_7_32",
  "title": "ГОСТ 7.32-2017. Отчёт о НИР",
  "rules": [
    {"id": "P01", "name": "Шрифт", "type": "parameter", "applies_to": "font_name", "scope": "non_title",
     "condition": "equals", "value": "Times New Roman", "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P02", "name": "Размер шрифта (кегль) основного текста", "type": "parameter", "applies_to": "font_size_pt", "scope": "body",
     "condition": "range", "min": 12, "max": null, "include_min": true, "include_max": false, "tolerance": 0.05, "unit": "пт",
     "source": "ГОСТ 7.32-2017, п. 2.1 («не менее 12 пт»)"},
    {"id": "P03", "name": "Межстрочный интервал основного текста", "type": "parameter", "applies_to": "line_spacing", "scope": "body",
     "condition": "range", "min": 1.5, "max": 1.5, "include_min": true, "include_max": true, "tolerance": 0.05,
     "source": "ГОСТ 7.32-2017, п. 2.1 (полуторный)"},
    {"id": "P04", "name": "Левое поле", "type": "parameter", "applies_to": "margin_left_mm", "scope": "document",
     "condition": "range", "min": 30, "max": 30, "include_min": true, "include_max": true, "tolerance": 1, "unit": "мм",
     "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P05", "name": "Правое поле", "type": "parameter", "applies_to": "margin_right_mm", "scope": "document",
     "condition": "range", "min": 15, "max": 15, "include_min": true, "include_max": true, "tolerance": 1, "unit": "мм",
     "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P06", "name": "Верхнее поле", "type": "parameter", "applies_to": "margin_top_mm", "scope": "document",
     "condition": "range", "min": 20, "max": 20, "include_min": true, "include_max": true, "tolerance": 1, "unit": "мм",
     "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P07", "name": "Нижнее поле", "type": "parameter", "applies_to": "margin_bottom_mm", "scope": "document",
     "condition": "range", "min": 20, "max": 20, "include_min": true, "include_max": true, "tolerance": 1, "unit": "мм",
     "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P08", "name": "Абзацный отступ основного текста", "type": "parameter", "applies_to": "first_line_indent_cm", "scope": "body",
     "condition": "range", "min": 1.25, "max": 1.25, "include_min": true, "include_max": true, "tolerance": 0.1, "unit": "см",
     "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P09", "name": "Выравнивание основного текста", "type": "parameter", "applies_to": "alignment", "scope": "body",
     "condition": "equals", "value": "по ширине", "source": "по образцу страниц ГОСТ (в тексте не указано)"},
    {"id": "P10", "name": "Полужирный шрифт в основном тексте", "type": "parameter", "applies_to": "bold_in_body", "scope": "body",
     "condition": "equals", "value": "без полужирного", "source": "ГОСТ 7.32-2017, п. 2.1 (полужирный только для заголовков)"},
    {"id": "P11", "name": "Заголовки выделены полужирным", "type": "parameter", "applies_to": "bold_in_heading", "scope": "headings",
     "condition": "equals", "value": "полужирный", "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P12", "name": "Номер страницы (поле PAGE в нижнем колонтитуле)", "type": "parameter", "applies_to": "page_number", "scope": "document",
     "condition": "equals", "value": "по центру", "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P13", "name": "Номер страницы на титульном листе", "type": "parameter", "applies_to": "title_page_number", "scope": "document",
     "condition": "equals", "value": "отсутствует", "source": "ГОСТ 7.32-2017, п. 2.1"},
    {"id": "P14", "name": "Количество ключевых слов в реферате", "type": "parameter", "applies_to": "keywords_count", "scope": "document",
     "condition": "range", "min": 5, "max": 15, "include_min": true, "include_max": true, "tolerance": 0, "unit": "шт.",
     "source": "ГОСТ 7.32-2017, п. 1.4.2"},
    {"id": "S01", "name": "Отсутствуют обязательные разделы", "type": "structure", "condition": "required_present",
     "source": "ГОСТ 7.32-2017, п. 1"},
    {"id": "S02", "name": "Нарушен порядок разделов", "type": "structure", "condition": "order",
     "source": "ГОСТ 7.32-2017, п. 1"}
  ],
