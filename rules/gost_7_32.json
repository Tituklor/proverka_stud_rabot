    {"key": "intro", "name": "Введение", "order": 7, "required": true, "titles": ["введение"]},
    {"key": "main", "name": "Основная часть", "order": 8, "required": true, "titles": []},
    {"key": "conclusion", "name": "Заключение", "order": 9, "required": true, "titles": ["заключение"]},
    {"key": "sources", "name": "Список использованных источников", "order": 10, "required": true,
     "titles": ["список использованных источников"]},
